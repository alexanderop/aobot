# Copy to .env. docker compose reads it.

# Which loop runs the Bots: api (an API key's model, the default) or acp (your own CLI's subscription).
AGENT_RUNTIME=api

# For api. MODEL_PROVIDER is anthropic, openai or openai-compat.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5-5
MODEL_API_KEY=
# Only for openai-compat (OpenRouter, a local server, the verify mock).
MODEL_BASE_URL=

# For acp: claude-code, codex or opencode, signed in as usual on this laptop. acp only starts with
# SINGLE_USER=true and HOST on loopback, so it never runs in compose: start the server on the host.
# ACP_AGENT=claude-code
# HOST=127.0.0.1

# Where people open the web app, such as https://aobot.example.com. Sign-in returns here. Unset,
# http://localhost:<PORT>.
# PUBLIC_URL=

# Sign-in with the company's OIDC provider. Compose sets these for its local Dex; a server elsewhere
# needs every one of them unless SINGLE_USER=true.
# OIDC_ISSUER=https://login.example.com
# Where the server reaches the issuer when it cannot at OIDC_ISSUER itself. Usually unset.
# OIDC_ISSUER_INTERNAL_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The domains whose addresses may sign in, comma-separated.
# SIGNIN_ALLOWED_EMAIL_DOMAINS=example.com
# The addresses made admins, comma-separated.
# ADMIN_EMAILS=

# Single-user mode: no sign-in, everything on one person's authority. Off unless set. The server refuses
# to start with it when PUBLIC_URL or HOST resolves to a public address, and warns on a private one or
# on HOST=0.0.0.0. Set HOST=127.0.0.1 with it to keep it on this machine.
# SINGLE_USER=true

# The Bot's computer. Compose sets these for its own stack; a server on the host uses the defaults.
# COMPUTER_PROVIDER=docker
# COMPUTER_IMAGE=aobot-computer:dev
# COMPUTER_NAME=aobot-computer
# DOCKER_SOCKET=/var/run/docker.sock
# Unset on the host: the computer's port is published on loopback. In compose: <project>_computers.
# COMPUTER_NETWORK=
# Lets the browser open private and loopback addresses, for local fixtures. Refused with AOBOT_ENV=production.
# COMPUTER_ALLOW_PRIVATE_HOSTS=false
