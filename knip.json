{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pgrep", "Xvfb"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/oxlint/*/index.ts",
        "tools/**/*.test.ts",
        "vite.smoke.config.ts",
        "verify/mock-model.ts",
        "vite.contract.config.ts"
      ],
      "project": ["tools/**/*.ts", "*.ts"],
      "ignore": ["tools/oxlint/anti-slop/**"],
      "ignoreDependencies": ["vite", "vitest"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/server": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.smoke.ts",
        "src/**/testing/fake-acp-agent.ts",
        "src/**/*.contract.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/computer": {
      "entry": ["src/**/*.test.ts", "src/**/*.contract.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
