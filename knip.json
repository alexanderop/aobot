{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/oxlint/*/index.ts", "tools/**/*.test.ts"],
      "project": ["tools/**/*.ts", "*.ts"],
      "ignore": ["tools/oxlint/anti-slop/**"],
      "ignoreDependencies": ["vite", "vitest"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/app/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/app/main.tsx", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
