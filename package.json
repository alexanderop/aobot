{
  "name": "aobot",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check && vp test run && knip",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:smoke": "vp test run --config vite.smoke.config.ts",
    "test:contract:agents": "vp test run --config vite.contract.config.ts",
    "knip": "knip",
    "verify": "node verify/run.ts",
    "dev:acp": "cd apps/web && vp build && cd ../.. && AGENT_RUNTIME=acp ACP_AGENT=${ACP_AGENT:-claude-code} SINGLE_USER=true HOST=127.0.0.1 PORT=${PORT:-3100} node apps/server/src/app/main.ts"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "knip": "6.44.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.28.10"
}
