{
  "name": "aobot",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --project unit --project architecture",
    "test:watch": "vitest",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run test && bun run knip"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^22.10.2",
    "knip": "6.44.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "effect": "4.1.0"
  }
}
